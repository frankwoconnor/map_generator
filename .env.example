# Example environment overrides
# Copy to .env and adjust as needed

# Where all runtime data lives: sources/, regions/, cache/ and output/.
# Defaults to the directory containing the repo (the sibling workspace), so
# leave this unset unless you want data on another disk.
# MAPGEN_DATA_DIR=/Volumes/bigdisk/mapgen

# Flask settings
FLASK_ENV=development
FLASK_DEBUG=1

# Bind host/port if needed
# FLASK_RUN_HOST=127.0.0.1
# FLASK_RUN_PORT=5000
